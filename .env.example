# ==========================================
# STICK SCAPE STUDIO — ENVIRONMENT CONFIG
# ==========================================

# Server Port (Default: 5000)
PORT=5000

# Environment Mode: 'development' | 'production'
NODE_ENV=production

# PostgreSQL Database Connection String (Supabase / Neon / Render / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/stickscapestudio?schema=public"

# Frontend Origin URL (for CORS if hosting frontend separately, e.g. Vercel)
# If hosting fullstack on single domain, this can remain default.
FRONTEND_URL="http://localhost:5173"

# JWT Secret Key for Admin & Customer Auth
JWT_SECRET="stick_scape_studio_jwt_secret_key_super_secret_2026"
JWT_EXPIRES_IN="7d"

# Default Admin Credentials (Auto-seeded on first run)
ADMIN_EMAIL="admin@stickscape.com"
ADMIN_PASSWORD="AdminPass123!"

# Admin WhatsApp / Mobile Number for instant notifications
VITE_ADMIN_MOBILE="8754132491"

# Frontend API URL (Set only if hosting frontend on separate domain like Vercel)
# VITE_API_URL="https://your-backend.onrender.com/api"
