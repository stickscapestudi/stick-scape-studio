# ==============================================================================
# STICK SCAPE STUDIO — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment Mode ('development' | 'production' | 'test')
NODE_ENV="development"

# Server Port
PORT=5000

# PostgreSQL Database Connection String
# MANDATORY in both Development and Production
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stickscape?schema=public"

# Allowed Frontend Origin URL for CORS Security
# Development: http://localhost:5173
# Production: MANDATORY — Must be set to live production URL (e.g., https://stickscape.com)
FRONTEND_URL="http://localhost:5173"

# JWT Authentication Secret
# Development: Local development fallback permitted
# Production: MANDATORY — Must be a cryptographically random string of AT LEAST 32 characters
JWT_SECRET="replace_with_32_character_random_string_in_production"
JWT_EXPIRES_IN="1h"

# Seed Admin Account Credentials
ADMIN_EMAIL="admin@stickscape.com"
ADMIN_PASSWORD="change_this_admin_password"

# Payment Gateway Provider Selection ('development' | 'razorpay')
PAYMENT_PROVIDER="development"

# Razorpay API Credentials
# Development: Test keys or local fallback
# Production: MANDATORY — Live Razorpay credentials required when PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID="rzp_test_placeholder"

# SERVER-ONLY SECRETS — NEVER EXPOSE TO FRONTEND OR BROWSER BUNDLE!
RAZORPAY_KEY_SECRET="razorpay_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="razorpay_webhook_secret_placeholder"
